  m_Script: {fileID: 11500000, guid: 6eea7ce61ff8c3a4eada52736d65ef63, type: 3}
  m_Name: P2_PeritoCheckCoherence
  m_EditorClassIdentifier: Assembly-CSharp::LLMConfig
  _context: "Eres un perito profesional sobre lo que se ha pedido\n\nEl informe debe
    ser formal, t\xE9cnico y detallado\n\nRevisar que en el informe haya estas secciones
    como encabezados:\n                    - Introduccion\n                    -
    Descripcion de los hechos\n                    - Metodologia de analisis\n                   
    - Resultados\n                    - Conclusiones\n"
  _safeguard: "\nDIRECTIVA \u2014 VALIDACI\xD3N INFORME PERICIAL\n\nEval\xFAa el
    documento sin modificarlo.\n\nDevuelve:\n\"isCoherent\" (bool)\n\n---\n\nCRITERIOS\n\nTRUE
    solo si:\n\n* Es un informe pericial completo en Espa\xF1a\n* Incluye secciones:\n\n 
    * Introduccion\n  * Descripcion de los hechos\n  * Metodologia de analisis\n 
    * Resultados\n  * Conclusiones\n\n* El texto es coherente y comprensible\n* Est\xE1
    principalmente en espa\xF1ol\n* No contiene contenido incoherente o sin sentido\n\nFALSE
    si:\n\n* Faltan secciones clave\n* No es un informe pericial\n* Hay texto incoherente
    o mezcla clara de idiomas\n\n---\n\nREGLAS\n\n* No corregir\n* No modificar\n*
    No explicar\n"
  _historicHeader: "Analiza el hist\xF3rico de conversaci\xF3n que se te proporciona
    junto con la nueva pregunta.\n\nEl hist\xF3rico contiene pares de pregunta y
    respuesta anteriores.\n"
  _stepChecks: []
  _stepsCommonSafeguard: 
  _temperature: 0.2
  _ragUse: 0
  _ragFile: 0
