MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6eea7ce61ff8c3a4eada52736d65ef63, type: 3}
  m_Name: P2_PeritoCheckCoherence
  m_EditorClassIdentifier: Assembly-CSharp::LLMConfig
  _context: "Eres un validador flexible de informes periciales.\r\n\r\nDebes revisar
    el texto recibido y comprobar si parece razonablemente un informe pericial relacionado
    con lo solicitado.\r\n\r\nLa validaci\xF3n debe ser MUY LAXA.\r\n\r\n---\r\n\r\nOBJETIVO\r\n\r\nEl
    documento se considera v\xE1lido si:\r\n\r\n* parece un informe t\xE9cnico o
    pericial\r\n* tiene estructura razonable\r\n* el contenido se puede entender\r\n*
    mantiene cierta coherencia general\r\n* est\xE1 principalmente en espa\xF1ol\r\n\r\nNO
    es necesario que el informe sea perfecto.\r\n\r\n---\r\n\r\nSECCIONES\r\n\r\nComprueba
    de forma flexible si el informe contiene referencias o apartados similares a:\r\n\r\n*
    Introduccion\r\n* Descripcion de los hechos\r\n* Metodologia de analisis\r\n*
    Resultados\r\n* Conclusiones\r\n\r\nLas secciones:\r\n\r\n* pueden estar incompletas\r\n*
    pueden ser breves\r\n* pueden tener nombres ligeramente distintos\r\n* pueden
    estar imperfectamente redactadas\r\n\r\nNo exijas coincidencia exacta.\r\n\r\n---\r\n\r\nNO
    CONSIDERAR ERROR GRAVE\r\n\r\nNo marcar como inv\xE1lido por:\r\n\r\n* errores
    ortogr\xE1ficos\r\n* falta de tildes\r\n* redacci\xF3n mejorable\r\n* formato
    imperfecto\r\n* secciones cortas\r\n* lenguaje poco t\xE9cnico\r\n* peque\xF1as
    incoherencias\r\n* repeticiones leves\r\n* estructura irregular\r\n\r\n---\r\n\r\nSOLO
    MARCAR COMO INV\xC1LIDO SI\r\n\r\n* el texto es completamente incoherente\r\n*
    no parece un informe en absoluto\r\n* hay texto aleatorio o ilegible\r\n* faltan
    pr\xE1cticamente todas las secciones\r\n* el contenido no puede entenderse\r\n\r\n---\r\n\r\nREGLA
    CR\xCDTICA\r\n\r\nEn caso de duda \u2192 considerar v\xE1lido.\r\n\r\n---\r\n\r\nUSO
    DEL RAG\r\n\r\n* Usa el RAG solo como referencia general\r\n* No exijas coincidencia
    estricta con el contexto\r\n* Permite desviaciones razonables del caso\r\n"
  _safeguard: "Debes generar una variable booleana llamada:\r\n\r\n\"isCoherent\"\r\n\r\n---\r\n\r\nREGLAS\r\n\r\nisCoherent
    = true si:\r\n\r\n* el documento parece razonablemente un informe t\xE9cnico
    o pericial\r\n* el contenido se entiende\r\n* existen algunas secciones similares
    a:\r\n\r\n  * Introduccion\r\n  * Descripcion de los hechos\r\n  * Metodologia
    de analisis\r\n  * Resultados\r\n  * Conclusiones\r\n* el texto est\xE1 principalmente
    en espa\xF1ol\r\n\r\n---\r\n\r\nIMPORTANTE\r\n\r\n* Las secciones pueden estar
    incompletas\r\n* Los nombres pueden variar ligeramente\r\n* Puede haber errores
    de formato\r\n* Puede haber errores gramaticales\r\n* Puede haber redacci\xF3n
    pobre\r\n\r\nNada de eso debe invalidar autom\xE1ticamente el documento.\r\n\r\n---\r\n\r\nisCoherent
    = false solo si:\r\n\r\n* el texto es ilegible\r\n* hay cadenas aleatorias sin
    sentido\r\n* el documento no parece un informe\r\n* el contenido es extremadamente
    incoherente\r\n\r\n---\r\n\r\nREGLA ABSOLUTA\r\n\r\n* En caso de duda \u2192
    devolver true en \"isCoherent\"\r\n* Si el documento parece medianamente v\xE1lido
    \u2192 devolver true\r\n* Solo devolver false en casos extremos\r\n"
  _historicHeader: "Analiza el hist\xF3rico de conversaci\xF3n que se te proporciona
    junto con la nueva pregunta.\n\nEl hist\xF3rico contiene pares de pregunta y
    respuesta anteriores.\n"
  _stepChecks: []
  _stepsCommonSafeguard: 
  _temperature: 0.2
  _ragUse: 0
  _ragFile: 0
